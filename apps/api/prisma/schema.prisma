generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}
enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
}
enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
enum Verification {
  LEGACY_UNVERIFIED
  VERIFIED
}
model User {
  id String @id @default(uuid())
  email String @unique
  passwordHash String
  role Role @default(EDITOR)
  active Boolean @default(true)
  sessions Session[]
  posts NewsPost[]
  createdAt DateTime @default(now())
  version Int @default(1)
}
model Session {
  id String @id @default(uuid())
  tokenHash String @unique
  csrfHash String
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
}
model AuditLog {
  id String @id @default(uuid())
  actorId String
  action String
  entity String
  entityId String
  changes Json @default("{}")
  result String @default("SUCCESS")
  createdAt DateTime @default(now())
  @@index([createdAt])
}
model Season {
  version Int @default(1)
  id String @id
  name String
  current Boolean @default(false)
  year Int?
  startsAt DateTime? @db.Date
  endsAt DateTime? @db.Date
  state String @default("PLANNED")
  memberships RosterMembership[]
  achievements ClubAchievement[]
  players PlayerSeason[]
  matches Match[]
  kffRecords RosterImportRecord[]
  sourceStaff StaffMember[] @relation("StaffSourceSeason")
  staffRevisions StaffRevision[]
}
model Team {
  category String? @unique
  status PublicationStatus @default(DRAFT)
  verification Verification @default(LEGACY_UNVERIFIED)
  overview Json @default("{}")
  source String @default("Pending club approval")
  staff StaffMember[]
  staffRevisions StaffRevision[]
  kffRecords RosterImportRecord[]
  version Int @default(1)
  id String @id @default(uuid())
  slug String @unique
  names Json
  logo String?
  managed Boolean @default(false)
  memberships RosterMembership[]
  matchStatistics PlayerMatchStatistics[]
  events MatchEvent[]
  players PlayerSeason[]
  homeMatches Match[] @relation("home")
  awayMatches Match[] @relation("away")
}
model Player {
  version Int @default(1)
  id String @id @default(uuid())
  slug String @unique
  names Json
  biography Json @default("{}")
  aliases Json @default("[]")
  kffRecords RosterImportRecord[]
  rosterStatus String @default("ACTIVE")
  archivedAt DateTime?
  memberships RosterMembership[]
  matchStatistics PlayerMatchStatistics[]
  events MatchEvent[]
  achievements ClubAchievement[]
  position String
  photo String?
  citizenship String?
  birthDate DateTime? @db.Date
  height Int?
  status PublicationStatus @default(DRAFT)
  verification Verification @default(LEGACY_UNVERIFIED)
  source String
  sourceDate DateTime
  seasons PlayerSeason[]
  updatedAt DateTime @updatedAt
}
model PlayerSeason {
  version Int @default(1)
  id String @id @default(uuid())
  playerId String
  player Player @relation(fields:[playerId],references:[id],onDelete:Restrict)
  seasonId String
  season Season @relation(fields:[seasonId],references:[id])
  teamId String
  team Team @relation(fields:[teamId],references:[id])
  number Int?
  statistics PlayerStatistics?
  @@unique([playerId,seasonId])
}
model PlayerStatistics {
  version Int @default(1)
  id String @id @default(uuid())
  playerSeasonId String @unique
  playerSeason PlayerSeason @relation(fields:[playerSeasonId],references:[id],onDelete:Restrict)
  mode String @default("CONFIRMED")
  verified Boolean @default(true)
  yellowCards Int?
  redCards Int?
  cleanSheets Int?
  appearances Int
  goals Int
  assists Int
  minutes Int
  source String
  updatedAt DateTime @updatedAt
}
model Competition {
  version Int @default(1)
  id String @id
  names Json
  matches Match[]
}
model Match {
  version Int @default(1)
  id String @id @default(uuid())
  seasonId String
  season Season @relation(fields:[seasonId],references:[id])
  competitionId String
  competition Competition @relation(fields:[competitionId],references:[id])
  homeTeamId String
  homeTeam Team @relation("home",fields:[homeTeamId],references:[id])
  awayTeamId String
  awayTeam Team @relation("away",fields:[awayTeamId],references:[id])
  kickoff DateTime
  stadium Json @default("{}")
  matchStatus String @default("SCHEDULED")
  homeScore Int?
  awayScore Int?
  status PublicationStatus @default(DRAFT)
  verification Verification @default(LEGACY_UNVERIFIED)
  source String
  sourceDate DateTime
  events MatchEvent[]
  playerStatistics PlayerMatchStatistics[]
  updatedAt DateTime @updatedAt
  @@index([kickoff,status])
  @@index([seasonId,matchStatus,status])
}
model MatchEvent {
  version Int @default(1)
  id String @id @default(uuid())
  matchId String
  match Match @relation(fields:[matchId],references:[id],onDelete:Restrict)
  playerId String?
  player Player? @relation(fields:[playerId],references:[id],onDelete:Restrict)
  teamId String?
  team Team? @relation(fields:[teamId],references:[id],onDelete:Restrict)
  eventKey String @default(uuid())
  cancelled Boolean @default(false)
  source String @default("Legacy import — unverified")
  minute Int
  type String
  description Json
  @@unique([matchId,eventKey])
}
model NewsPost {
  version Int @default(1)
  id String @id @default(uuid())
  slug String @unique
  status PublicationStatus @default(DRAFT)
  cover String?
  images Json @default("[]")
  categoryId String?
  category Category? @relation(fields:[categoryId],references:[id])
  authorId String?
  author User? @relation(fields:[authorId],references:[id])
  translations NewsTranslation[]
  publishedAt DateTime?
  source String
  sourceDate DateTime
  verification Verification @default(LEGACY_UNVERIFIED)
  updatedAt DateTime @updatedAt
}
model NewsTranslation {
  id String @id @default(uuid())
  postId String
  post NewsPost @relation(fields:[postId],references:[id],onDelete:Cascade)
  locale String
  title String
  excerpt String
  body String
  @@unique([postId,locale])
}
model Category {
  version Int @default(1)
  id String @id @default(uuid())
  slug String @unique
  names Json
  posts NewsPost[]
}
model MediaAsset {
  version Int @default(1)
  id String @id @default(uuid())
  url String @unique
  mime String
  size Int
  width Int?
  height Int?
  alt Json
  variants Json @default("{}")
  storage String @default("local")
  uploadedBy String
  createdAt DateTime @default(now())
}
model GalleryItem {
  version Int @default(1)
  id String @id @default(uuid())
  title Json
  url String
  poster String?
  kind String
  sortOrder Int @default(0)
  status PublicationStatus @default(DRAFT)
  source String
  updatedAt DateTime @updatedAt
}
model ClubInfo {
  version Int @default(1)
  id String @id
  content Json
  source String
  verification Verification @default(LEGACY_UNVERIFIED)
  updatedAt DateTime @updatedAt
}
model ClubAchievement {
  clubKey String @default("ordabasy")
  competitionKey String?
  achievementType String @default("MILESTONE")
  status PublicationStatus @default(DRAFT)
  version Int @default(1)
  id String @id @default(uuid())
  playerId String?
  player Player? @relation(fields:[playerId],references:[id],onDelete:Restrict)
  seasonId String?
  season Season? @relation(fields:[seasonId],references:[id],onDelete:Restrict)
  year Int?
  title Json
  description Json
  source String
  verification Verification @default(LEGACY_UNVERIFIED)
}
model StaffMember {
  externalKey String? @unique
  aliases Json @default("[]")
  sourceUrl String?
  sourceCapturedAt DateTime?
  sourceSeasonId String?
  sourceSeason Season? @relation("StaffSourceSeason",fields:[sourceSeasonId],references:[id],onDelete:Restrict)
  roleCode String @default("OTHER")
  nationality String?
  sortOrder Int @default(100)
  archivedAt DateTime?
  revisions StaffRevision[]
  teamId String?
  team Team? @relation(fields:[teamId],references:[id],onDelete:Restrict)
  version Int @default(1)
  id String @id @default(uuid())
  names Json
  title Json
  photo String?
  group String
  status PublicationStatus @default(DRAFT)
  source String
  verification Verification @default(LEGACY_UNVERIFIED)
}

// Recorded CMS versions, not invented employment start/end dates.
model StaffRevision {
  id String @id @default(uuid())
  staffId String
  staff StaffMember @relation(fields:[staffId],references:[id],onDelete:Restrict)
  staffVersion Int
  teamId String?
  team Team? @relation(fields:[teamId],references:[id],onDelete:Restrict)
  seasonId String?
  season Season? @relation(fields:[seasonId],references:[id],onDelete:Restrict)
  title Json
  roleCode String
  status PublicationStatus
  source String
  recordedAt DateTime @default(now())
  @@unique([staffId,staffVersion])
}

// An attributed season registration and editorial decision. Never an active contract.
model RosterImportRecord {
  id String @id @default(uuid())
  referenceKey String @unique
  profileExternalId String?
  seasonId String
  season Season @relation(fields:[seasonId],references:[id],onDelete:Restrict)
  playerId String?
  player Player? @relation(fields:[playerId],references:[id],onDelete:Restrict)
  teamId String?
  team Team? @relation(fields:[teamId],references:[id],onDelete:Restrict)
  sourceUrl String
  profileUrl String?
  sourceCapturedAt DateTime
  sourceName String
  sourcePosition String
  sourceNationality String?
  shirtNumber Int
  profileTeam String?
  profilePosition String?
  position String?
  positionSource String?
  evidence Json
  conflicts Json @default("[]")
  proposedAliases Json @default("[]")
  matchKind String
  reviewStatus String @default("PENDING")
  reviewNotes String @default("")
  reviewedBy String?
  reviewedAt DateTime?
  version Int @default(1)
  @@unique([seasonId,profileExternalId])
  @@index([seasonId,teamId,reviewStatus])
}
model LeagueStandingSnapshot {
  id String @id @default(uuid())
  leagueId String
  season String
  rows Json
  source String
  fetchedAt DateTime @default(now())
  @@index([leagueId,season,fetchedAt])
}
model ClubSettings {
  version Int @default(1)
  id String @id @default("main")
  sections Json
  leagueId String?
  externalSeason String?
  timezone String @default("Asia/Almaty")
  updatedAt DateTime @updatedAt
}

model RosterMembership {
  cancelled Boolean @default(false)
  datesVerified Boolean @default(true)
  id String @id @default(uuid())
  playerId String
  player Player @relation(fields:[playerId],references:[id],onDelete:Restrict)
  teamId String
  team Team @relation(fields:[teamId],references:[id],onDelete:Restrict)
  seasonId String
  season Season @relation(fields:[seasonId],references:[id],onDelete:Restrict)
  number Int?
  startsAt DateTime
  endsAt DateTime?
  departureReason String?
  nextClub String?
  version Int @default(1)
  @@index([playerId,seasonId])
  @@index([teamId,seasonId,endsAt])
}
model PlayerMatchStatistics {
  teamId String?
  team Team? @relation(fields:[teamId],references:[id],onDelete:Restrict)
  id String @id @default(uuid())
  matchId String
  match Match @relation(fields:[matchId],references:[id],onDelete:Restrict)
  playerId String
  player Player @relation(fields:[playerId],references:[id],onDelete:Restrict)
  appearances Int @default(1)
  minutes Int
  cleanSheets Int?
  verified Boolean @default(false)
  source String
  version Int @default(1)
  @@unique([matchId,playerId])
  @@index([playerId,teamId])
}
model MutationKey {
  id String @id @default(uuid())
  key String
  userId String
  response Json
  createdAt DateTime @default(now())
  @@unique([userId,key])
  @@index([createdAt])
}

model Sponsor {
  id String @id @default(uuid())
  name String @unique
  logo String?
  description Json @default("{}")
  websiteUrl String?
  tier String?
  status PublicationStatus @default(DRAFT)
  sortOrder Int @default(0)
  validFrom DateTime?
  validUntil DateTime?
  verificationSource String?
  verifiedAt DateTime?
  logoApproved Boolean @default(false)
  youthSafe Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version Int @default(1)
}
model AcademyPage {
  id String @id @default("main")
  content Json @default("{}")
  status PublicationStatus @default(DRAFT)
  admissionState String @default("UNCONFIRMED")
  inquiriesEnabled Boolean @default(false)
  contactEmail String?
  contactPhone String?
  source String
  version Int @default(1)
  updatedAt DateTime @updatedAt
}
model AcademyInquiry {
  id String @id @default(uuid())
  guardianName String?
  contact String?
  ageGroup String?
  message String?
  locale String
  consentAt DateTime
  privacyVersion String
  state String @default("NEW")
  createdAt DateTime @default(now())
  expiresAt DateTime
  purgedAt DateTime?
  version Int @default(1)
  @@index([expiresAt,purgedAt])
}
model InquiryRateBucket {
  key String @id
  count Int @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}
