# Copy to .env. Replace all CHANGE_ME values before Docker startup.
POSTGRES_USER=ordabasy
POSTGRES_PASSWORD=CHANGE_ME_long_random_database_password
POSTGRES_DB=ordabasy
DATABASE_URL=postgresql://ordabasy:CHANGE_ME_long_random_database_password@localhost:5432/ordabasy?schema=public
API_PORT=4000
API_HOST=0.0.0.0
API_INTERNAL_URL=http://127.0.0.1:4000/api/v1
PUBLIC_ORIGIN=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000
# Leave blank for direct local API access or unverified forwarding headers.
# Production Compose trusts its private Caddy network; API ports stay private.
TRUST_PROXY_CIDRS=
COOKIE_SECURE=false
DISPLAY_TIMEZONE=Asia/Almaty
MEDIA_DIR=./media-data
API_FOOTBALL_KEY=
FOOTBALL_LEAGUE_ID=
FOOTBALL_SEASON=
STANDINGS_TTL_SECONDS=3600
ADMIN_EMAIL=
ADMIN_PASSWORD=
# VPS production only
# API connects with a DML-only role; migrate keeps the schema owner from POSTGRES_USER.
# Provision it with infra/runtime-role.sql; never use the PostgreSQL bootstrap superuser in the public API.
API_DATABASE_URL=
DOMAIN=example.com
ACME_EMAIL=webmaster@example.com
# Local production-preview only. compose.prod.yaml always disables this.
ALLOW_LOCAL_HTTP=true
# Optional console bootstrap: SUPER_ADMIN (default), ADMIN or EDITOR.
BOOTSTRAP_ROLE=SUPER_ADMIN

# Development uses the named media volume. Production requires independent S3 storage.
MEDIA_STORAGE=local
S3_REGION=us-east-1
S3_ENDPOINT=
S3_BUCKET=
S3_FORCE_PATH_STYLE=false
# Prefer a workload IAM role when supported. Never expose these to the frontend.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Restoration is allowed only into a separate empty database and media directory.
RESTORE_DATABASE_URL=
RESTORE_MEDIA_DIR=
RESTORE_S3_BUCKET=

# Optional academy inquiry form: generate a unique random server-only value (32+ characters).
# The form stays disabled without this key and CMS approval. Never expose it to the browser.
INQUIRY_RATE_SECRET=

# Railway only: see docs/RAILWAY.md. Keep separate credentials for the same DB.
# Pre-deploy runner uses this server-only secret; API queries use DATABASE_URL.
MIGRATION_DATABASE_URL=
RAILWAY_SEED_ON_DEPLOY=false
# Railway web API_INTERNAL_URL is both a Docker build ARG and runtime variable.
# A backend hostname change requires a web rebuild, not only a restart.

# Render: API_ORIGIN is the actual API HTTPS origin (no /api/v1).
# It takes precedence over API_INTERNAL_URL and is available at Docker build + runtime.
API_ORIGIN=
API_FETCH_TIMEOUT_MS=
# Explicit read-only media mode for the temporary Free demo; no disk uploads.
# Use DEMO_MODE=true and MEDIA_STORAGE=disabled together. Production keeps s3.
DEMO_MODE=false
# Render runtime uses the DML role only; never put the owner URL in its service env.
APP_DB_USER=ordabasy_app
APP_DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_NAME=
# Local release command only (owner URL stays on the operator machine).
RENDER_DATABASE_NAME=
RENDER_SEED_ON_DEPLOY=false
